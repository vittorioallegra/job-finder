{
  "name": "@job-finder/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for job-finder: main process, preload and E2E smoke test.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "test:e2e": "pnpm build && playwright test -c playwright.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@job-finder/bridge": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@job-finder/core": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  }
}
