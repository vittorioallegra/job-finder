{
  "name": "@job-finder/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for job-finder: main process, preload and E2E smoke test.",
  "license": "MIT",
  "homepage": "https://github.com/vittorioallegra/job-finder",
  "author": "Vittorio Allegra <vittorioallegra@users.noreply.github.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "test:e2e": "pnpm build && playwright test -c playwright.config.ts",
    "test:e2e:packaged": "playwright test -c playwright.config.ts packaged.spec.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@job-finder/bridge": "workspace:*",
    "@job-finder/core": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  }
}
